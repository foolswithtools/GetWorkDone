{
  "name": "@getworkdone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "lint": "eslint --max-warnings=0 .",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1155.0",
    "@aws-sdk/client-sesv2": "3.1155.0",
    "@getworkdone/contracts": "workspace:*",
    "@getworkdone/db": "workspace:*",
    "@getworkdone/telemetry": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@opentelemetry/api": "1.9.1",
    "jose": "6.2.12",
    "nodemailer": "10.2.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  }
}
