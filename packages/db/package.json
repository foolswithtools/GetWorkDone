{
  "name": "@getworkdone/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "sql",
    "src/database-url.ts"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p .",
    "lint": "eslint --max-warnings=0 .",
    "db:migrate": "prisma migrate deploy",
    "db:check": "prisma validate"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "prisma": "7.10.1"
  }
}
